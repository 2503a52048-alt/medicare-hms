# Copy this file to .env and fill in your own values. Never commit .env.

NODE_ENV=development
PORT=3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medicare_hms
# Cloud MySQL (Render deployment): DB_SSL=true, and DB_SKIP_CREATE=true when the provider gives you a ready-made database.
DB_SSL=false
DB_SKIP_CREATE=false

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=8h

# ---- OTP ----
# dev  : OTP is printed in the server console (and returned in the API response when NODE_ENV != production)
# twilio : sends real SMS through Twilio Verify-style messaging
OTP_MODE=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email ----
# dev  : emails are printed in the server console
# smtp : sends through your SMTP server (for example Gmail app password)
MAIL_MODE=dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MediCare Hospital <no-reply@medicare.example>"

# ---- Payments ----
# test : built-in simulated gateway (clearly labelled TEST MODE in the UI)
# razorpay : Razorpay in test mode (use rzp_test_ keys)
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Demo data (development only) ----
# Password given to the fictional demo accounts created by `npm run db:seed`.
# The seed script refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD=Demo@12345
